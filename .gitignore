__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.env.*
!.env.example
.ipynb_checkpoints/

# Never commit raw motorsport datasets or caches.
data/raw/**
data/cache/**
data/processed/**
!data/raw/.gitkeep
!data/cache/.gitkeep
!data/processed/.gitkeep

artifacts/**
!artifacts/.gitkeep
# The small synthetic demo artifact is a committed fixture; real trained artifacts stay out of git.
!artifacts/raceshift_ffr_demo/
!artifacts/raceshift_ffr_demo/**
# One real FFR-M artifact is committed so the UI can show a real-data model out of the box.
!artifacts/f1_2025h2_ffr-m/
!artifacts/f1_2025h2_ffr-s/
!artifacts/f1_2025h2_ffr-m/**
!artifacts/f1_2025h2_ffr-s/**
!artifacts/f1_2025h2_legacy_ext_ffr-s/
!artifacts/f1_2025h2_legacy_ext_ffr-s/**
# Baseline runs: only the small metrics files are committed so the UI shows the tree/ridge
# rows the README leads with; the fitted baseline models and predictions stay out of git.
!artifacts/*_baselines/
!artifacts/*_baselines/metrics.json

# Model/checkpoint files
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Local notebook / IDE state
.vscode/
.idea/
.DS_Store

# Web build artifacts and package caches
node_modules/
dist/
.vite/
coverage/

# ML experiment/runtime caches
wandb/
mlruns/
lightning_logs/
.huggingface/
*.bin
*.gguf

# Secrets and cloud credentials
*.pem
*.key
service-account*.json
credentials*.json

# Local datasets are never committed. Two small tables ship with the repo: the synthetic
# fixture and one real season (2025 races, FastF1 timing, 640 KB) so the first forecast is real.
data/imports/*.parquet
data/imports/*.csv
!data/imports/synthetic_fixture.csv
!data/imports/f1_2025_season.parquet
!data/imports/f1_2026_races.parquet

# Export bundles are rebuilt on demand by the API or scripts/export_model.py
exports/
