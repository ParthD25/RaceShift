{
  "split": {
    "train_end": 2023,
    "val_year": 2024,
    "test_year": 2025
  },
  "data": {
    "history_laps": 5,
    "batch_size": 256
  },
  "model": {
    "d_model": 128,
    "n_heads": 4,
    "n_layers": 3,
    "dropout": 0.15,
    "max_history": 16
  },
  "training": {
    "epochs": 50,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "accumulation_steps": 1,
    "use_amp": true,
    "optimizer": "adamw",
    "warmup_steps": 0,
    "patience": 8
  }
}
