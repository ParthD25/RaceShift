  "weight_decay": 1e-05,
  "temperature": 0.55,
  "target_sigma_groups": 1.1,
  "ridge_alpha": 2.0,
  "seed": 42,
  "clip_update_norm": 5.0,
  "notes": "Group-ladder ablation of FFR-M: 4/8/16/32 ordinal groups."
}
